# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf

# Jupyter Notebooks
*.ipynb text eol=lf

# Explicitly declare text files you want to always be normalized and UTF-8
*.py text eol=lf diff=python
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.parquet binary
*.xlsx binary
*.zip binary
